# ============================================================
# .env.example — Copy to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Flask Core
# ----------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
# IMPORTANT: Set a strong random value in production (e.g., python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# Examples:
#   SQLite   → sqlite:///ai_decision.db
#   Postgres → postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ----------------------------------------------------------
# ERP Integration (Frappe / ERPNext)
# ----------------------------------------------------------
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=

# ----------------------------------------------------------
# Model artefact versions (optional — defaults shown)
# Set to a different stem to point at a promoted model file.
# Example: SALES_MODEL_VERSION=sales_rf_v2  → models/sales_rf_v2.pkl
# ----------------------------------------------------------
SALES_MODEL_VERSION=sales_rf
INVENTORY_MODEL_VERSION=inventory_rf

# ----------------------------------------------------------
# Frontend / CORS (Sprint 7 — Next.js Enterprise UI)
# ----------------------------------------------------------
# Origin(s) allowed to call the Flask API.
# In development this is the Next.js dev server.
# In production set to your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------------------------------------
# LLM Provider Keys
# ----------------------------------------------------------
# Supported providers: gemini | openai
# Set the active provider in model_config.yaml or via the Settings UI
LLM_PROVIDER=gemini
# Google Gemini (default)
GEMINI_API_KEY=
# OpenAI (alternate)
OPENAI_API_KEY=
