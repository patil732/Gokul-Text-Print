# ============================================================
# .env.example — Copy to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Flask Core
# ----------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# Examples:
#   SQLite   → sqlite:///ai_decision.db
#   Postgres → postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ----------------------------------------------------------
# ERP Integration (Frappe / ERPNext)
# ----------------------------------------------------------
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=

# ----------------------------------------------------------
# Model artefact versions (optional — defaults shown)
# Set to a different stem to point at a promoted model file.
# Example: SALES_MODEL_VERSION=sales_rf_v2  → models/sales_rf_v2.pkl
# ----------------------------------------------------------
SALES_MODEL_VERSION=sales_rf
INVENTORY_MODEL_VERSION=inventory_rf

# ----------------------------------------------------------
# LLM Provider (reserved for future sprint — no code yet)
# ----------------------------------------------------------
# Supported values (planned): openai | anthropic | google | ollama
LLM_PROVIDER=
LLM_API_KEY=
